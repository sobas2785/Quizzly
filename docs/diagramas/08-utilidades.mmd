classDiagram
    direction TB

    class Sesion {
        <<object>>
        +SIN_SESION = -1
        +DIAS_DE_VIGENCIA = 30
        +iniciar(context, usuarioId)
        +usuarioId(context) Long
        +usuarioVigente(context, ahora) Long
        +vencio(inicio, ahora) Boolean
        +cerrar(context)
    }

    class Sonidos {
        <<object>>
        -pool: SoundPool
        -pista: MediaPlayer
        +inicializar(context)
        +estaSilenciado(context) Boolean
        +alternarSilencio(context) Boolean
        +toque(context)
        +acierto(context)
        +error(context)
        +tiempoAgotado(context)
        +girarRuleta(context)
        +ruletaDetenida(context)
        +cambioDeTurno(context)
        +cronometro(context)
        +racha(context)
        +finDePartida(context, desenlace, subioDeNivel, hayLogros)
        +detenerPista()
    }

    class Vibracion {
        <<object>>
        +acierto(context)
        +error(context)
        +tiempoAgotado(context)
        +categoriaElegida(context)
        +toque(context)
    }

    class HashUtils {
        <<object>>
        +hashear(contrasena, iteraciones) String
        +verificar(contrasena, guardado) Boolean
        +esFormatoViejo(guardado) Boolean
        +sha256(texto) String
    }

    class Efectos["Efectos.kt"] {
        <<funciones>>
        +AppCompatActivity.alRecibir(efectos, accion)
    }

    note for Sesion "Guarda el usuario logueado y cuándo<br/>inició sesión, en SharedPreferences.<br/>La sesión vence a los 30 días."
    note for HashUtils "PBKDF2 con salt (120.000 iteraciones).<br/>Acepta el SHA-256 viejo para convertirlo."
    note for Sonidos "SoundPool: efectos cortos<br/>MediaPlayer: pistas largas<br/>El silencio se recuerda entre sesiones"
